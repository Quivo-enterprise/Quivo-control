{
  "name": "@quivo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-fastify": "^11.0.6",
    "@nestjs/throttler": "^6.5.0",
    "@quivo/db": "workspace:*",
    "@quivo/shared": "workspace:*",
    "@sentry/node": "^8.51.0",
    "better-auth": "1.4.22",
    "bullmq": "^6.0.0",
    "fastify": "^5.11.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.3.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
