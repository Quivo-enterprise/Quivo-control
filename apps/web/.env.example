# URL de apps/api (ver docker-compose.yml + apps/api/README.md) — 3001, no 3000: ese
# puerto ya lo usa esta app ("next dev").
NEXT_PUBLIC_API_URL=http://localhost:3001

# El bypass solo permite navegar la interfaz: su token ficticio no puede consultar la API
# ni cargar combos/CRUD reales. Déjalo desactivado para el desarrollo normal.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Google Maps (mapa de /en-vivo). Son build-time: Next las inlinea en el bundle del cliente.
# API key de NAVEGADOR restringida por referrer (http://localhost:3000/* en desarrollo). En
# producción sale de Secret Manager (`google-maps-web-key`, ver scripts/deploy-gcp.sh).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID vectorial (Google Cloud Console > Map Management). Para desarrollo: DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
