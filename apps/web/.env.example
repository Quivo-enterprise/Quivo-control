# URL de apps/api (ver docker-compose.yml + apps/api/README.md)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Bypass de sesión SOLO para desarrollo local: simula un usuario admin_quivo mientras
# QUI-219 (auth real) no exista. auth-context.tsx lo ignora si NODE_ENV=production.
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
