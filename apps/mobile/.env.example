EXPO_PUBLIC_USE_MOCK_ROUTE=true

# URL base de la API. En dev local NO se setea acá: `pnpm dev` (scripts/dev-all.sh) la
# exporta sola, detectando la IP de la LAN de la PC (ver EXPO_PUBLIC_API_URL en ese script).
# Para builds de EAS (development/production), la variable vive en `eas.json` -> build.<perfil>.env
# — el perfil `production` (release) trae hoy un placeholder obvio
# (https://CONFIGURAR-URL-CLOUD-RUN.invalid) que el CTO tiene que reemplazar por la URL real de
# Cloud Run antes de buildear el release del piloto.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# DSN de Sentry (QUI-365). Los DSN de Sentry están pensados para ir embebidos en el cliente
# (no son secretos), por eso llevan el prefijo EXPO_PUBLIC_ como el resto de las variables que
# necesita el bundle JS. Sin esta variable, `initSentry()` (src/shared/observability/sentry.ts)
# no llama a Sentry.init y no pasa nada — mismo patrón condicional que apps/api. Se setea en
# `eas.json` -> build.<perfil>.env para los builds de EAS.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Key JWT del trial de 30 días de Transistorsoft (QUI-350). A diferencia de las de arriba, esta
# NO lleva prefijo EXPO_PUBLIC_: se consume solo durante `expo prebuild` (dentro de
# app.config.ts, para el plugin `react-native-background-geolocation`) y nunca debe llegar al
# bundle JS. Se setea como EAS secret (`eas secret:create --name TRANSISTORSOFT_LICENSE_KEY
# --value "<key>" --type string`), no en este archivo ni en eas.json.
# TRANSISTORSOFT_LICENSE_KEY=
