{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "RUNTIME_DATABASE_URL",
        "JWT_SECRET",
        "REDIS_URL",
        "BETTER_AUTH_URL",
        "NODE_ENV",
        "JWT_ACCESS_TTL",
        "JWT_REFRESH_TTL"
      ]
    }
  }
}
