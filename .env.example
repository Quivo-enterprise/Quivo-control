# API
NODE_ENV=development
PORT=3000

# Postgres (levantado con docker-compose.yml — service "postgres", puerto host 5434 para
# evitar choques con otros Postgres locales en esta máquina de desarrollo)
DATABASE_URL=postgresql://quivo:quivo_dev@localhost:5434/quivo_control

# Redis / BullMQ (servicio "redis")
REDIS_URL=redis://localhost:6379

# Auth (Better-Auth + JWT, doc técnico §5) — nunca uses este valor en producción
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Observabilidad
SENTRY_DSN=
