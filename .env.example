# API
# 3001, no 3000: apps/web ("next dev") ya usa el 3000 — si corrés ambas apps en la misma
# máquina para probar el login end-to-end, necesitan puertos distintos.
NODE_ENV=development
PORT=3001
# URL pública de la API usada por el seed para el emblema de referencia de la Línea 120.
API_PUBLIC_URL=http://localhost:3001

# Postgres (levantado con docker-compose.yml — service "postgres", puerto host 5434 para
# evitar choques con otros Postgres locales en esta máquina de desarrollo)
DATABASE_URL=postgresql://quivo:quivo_dev@localhost:5434/quivo_control

# Rol de runtime sin superuser/BYPASSRLS (QUI-218) — ver apps/api/.env y
# packages/db/prisma/migrations/20260730152500_rls_multi_tenant.
RUNTIME_DATABASE_URL=postgresql://quivo_app:quivo_app_dev@localhost:5434/quivo_control

# Redis / BullMQ (servicio "redis", puerto host 6380 — evita choque con otro Redis local
# en esta máquina de desarrollo, mismo motivo que el 5434 de Postgres arriba)
REDIS_URL=redis://localhost:6380

# CORS: origen de apps/web (":3000" en dev, "next dev") — sin esto el browser bloquea
# el preflight de POST /v1/auth/login (curl no lo sufre: CORS es una restricción del
# browser, no del server).
CORS_ORIGIN=http://localhost:3000
# Número público de WhatsApp al que la landing ofrece continuar la solicitud.
DEMO_WHATSAPP_NUMBER=59168482323

# Auth (Better-Auth + JWT, doc técnico §5). Generá el tuyo con `openssl rand -base64 32`
# (mínimo 32 caracteres) — NUNCA reutilices un valor de ejemplo ni lo comitees. Fuera de
# development, packages/db/src/auth.ts rechaza el arranque si esta variable falta, es un
# valor de ejemplo conocido, o es demasiado corta (QUI-356).
JWT_SECRET=__GENERAR_CON_openssl_rand_-base64_32__NO_USAR_ESTE_VALOR__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MOBILE_CHALLENGE_TTL_SECONDS=300
MOBILE_ACCESS_TTL_SECONDS=900
MOBILE_REFRESH_TTL_SECONDS=2592000
# Los tres siguientes sólo tienen default fuera de NODE_ENV=development: packages/db/prisma/seed.ts
# aborta si faltan en cualquier otro ambiente (staging/test/producción) en vez de caer en silencio
# al valor demo — ver el comentario de resolveSeedSecret() en ese archivo para el porqué.
# Password de los usuarios web que crea el seed (admin_quivo incluido); documentada en apps/api/README.md.
SEED_ADMIN_PASSWORD=Quivo123!
# PIN demo del vehículo sembrado; documentado en docs/dev/credenciales-demo.md.
MOBILE_SEED_VEHICLE_PIN=246810
# PIN demo del conductor sembrado; documentado en docs/dev/credenciales-demo.md.
MOBILE_SEED_DRIVER_PIN=135790

# Sin esto, el plugin `jwt` firma `iss`/`aud` vacíos y `auth.api.verifyJWT` rechaza
# cualquier token (usado por JwtAuthGuard en endpoints protegidos, QUI-220 en adelante).
BETTER_AUTH_URL=http://localhost:3001

# Motor de ruteo self-hosted (docker-compose "osrm", puerto host 5001) — necesita el mapa
# vial procesado antes: `bash scripts/setup-osrm.sh` (ver RuteoService).
OSRM_URL=http://localhost:5001

# Observabilidad
SENTRY_DSN=

# Archivo frío GPS (M5, QUI-252). Es opt-in: al activarlo, el worker exporta particiones
# mayores a 6 meses, verifica el objeto remoto completo y recién entonces las retira de PG.
GPS_ARCHIVE_ENABLED=false
GPS_RETENTION_MONTHS=6
GPS_ARCHIVE_MAX_PARTITIONS_PER_RUN=1
GPS_ARCHIVE_SCHEDULE_MS=86400000
GPS_ARCHIVE_BUCKET=
GPS_ARCHIVE_PREFIX=quivo-control
# Endpoint S3-compatible; para AWS S3 se deja vacío. R2: https://<account-id>.r2.cloudflarestorage.com
GPS_ARCHIVE_ENDPOINT=
GPS_ARCHIVE_FORCE_PATH_STYLE=false
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
