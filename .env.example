# API
# 3001, no 3000: apps/web ("next dev") ya usa el 3000 — si corrés ambas apps en la misma
# máquina para probar el login end-to-end, necesitan puertos distintos.
NODE_ENV=development
PORT=3001

# Postgres (levantado con docker-compose.yml — service "postgres", puerto host 5434 para
# evitar choques con otros Postgres locales en esta máquina de desarrollo)
DATABASE_URL=postgresql://quivo:quivo_dev@localhost:5434/quivo_control

# Rol de runtime sin superuser/BYPASSRLS (QUI-218) — ver apps/api/.env y
# packages/db/prisma/migrations/20260730152500_rls_multi_tenant.
RUNTIME_DATABASE_URL=postgresql://quivo_app:quivo_app_dev@localhost:5434/quivo_control

# Redis / BullMQ (servicio "redis")
REDIS_URL=redis://localhost:6379

# CORS: origen de apps/web (":3000" en dev, "next dev") — sin esto el browser bloquea
# el preflight de POST /v1/auth/login (curl no lo sufre: CORS es una restricción del
# browser, no del server).
CORS_ORIGIN=http://localhost:3000

# Auth (Better-Auth + JWT, doc técnico §5) — nunca uses este valor en producción
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Sin esto, el plugin `jwt` firma `iss`/`aud` vacíos y `auth.api.verifyJWT` rechaza
# cualquier token (usado por JwtAuthGuard en endpoints protegidos, QUI-220 en adelante).
BETTER_AUTH_URL=http://localhost:3001

# Observabilidad
SENTRY_DSN=
