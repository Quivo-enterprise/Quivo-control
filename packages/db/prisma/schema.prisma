// Modelos User/Session/Account/Verification/Jwks generados por
// `pnpm --filter @quivo/db exec better-auth generate --config src/auth.ts --output prisma/schema.prisma`
// a partir de la config de Better-Auth en src/auth.ts (QUI-219) — no se escriben a mano
// (doc técnico §5: "no construir auth a mano"). `rol`/`sindicatoId` en `User` vienen de
// `user.additionalFields` en esa config. Si `auth.ts` cambia (nuevos additionalFields, un
// plugin nuevo, etc.), volver a correr ese comando y generar una migración nueva — no
// editar los modelos de abajo directamente.
//
// @better-auth/cli quedó pineado en 1.4.22 (igual que `better-auth`, ver package.json):
// es la versión más reciente publicada del CLI y no soporta la línea 1.6.x de
// `better-auth` (bug de compatibilidad conocido — el CLI no se actualizó). Si en el
// futuro se sube `better-auth` a 1.6.x, hay que volver a generar el schema a mano
// (comparando contra la doc de Better-Auth) o esperar a que el CLI publique una versión
// compatible.

generator client {
  provider = "prisma-client-js"
}

// La URL de conexión vive en prisma.config.ts (Prisma 7 ya no la acepta acá, ver
// https://pris.ly/d/config-datasource) — el driver adapter (@prisma/adapter-pg) en
// src/client.ts es quien conecta en runtime.

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rol           String
  sindicatoId   String?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

// Entidades núcleo (QUI-217, doc técnico §4.2). `estado` queda como String libre en vez de
// un enum nativo de Postgres porque la única fuente de verdad de los valores permitidos es
// el enum Zod en packages/shared (`EstadoXSchema`) — evita mantener el mismo enum en dos
// lugares. RLS (políticas + FORCE) se agrega en una migración separada (QUI-218) sobre estas
// mismas tablas.

model Sindicato {
  id        String   @id @default(uuid())
  nombre    String
  estado    String   @default("activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socios                   Socio[]
  vehiculos                Vehiculo[]
  conductores              Conductor[]
  lineas                   Linea[]
  auditLogs                AuditLog[]
  rotaciones               Rotacion[]
  reglas                   Regla[]
  sanciones                Sancion[]
  desafiosAuthMovil        DesafioAuthMovil[]
  sesionesOperativas       SesionOperativa[]
  historialEstadosVehiculo HistorialEstadoVehiculo[]
  cumplimientosPc          CumplimientoPc[]
  eventosOperativos        EventoOperativo[]
  syncErrors               SyncError[]

  @@map("sindicatos")
}

model Socio {
  id                 String    @id @default(uuid())
  sindicatoId        String
  sindicato          Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  nombre             String
  documentoIdentidad String
  estado             String    @default("activo")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehiculos Vehiculo[]

  @@unique([sindicatoId, documentoIdentidad])
  @@index([sindicatoId])
  @@map("socios")
}

model Vehiculo {
  id               String    @id @default(uuid())
  sindicatoId      String
  sindicato        Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  socioId          String?
  socio            Socio?    @relation(fields: [socioId], references: [id], onDelete: SetNull)
  placa            String
  placaNormalizada String?   @unique
  tipo             String
  marca            String
  modelo           String
  color            String
  colorSecundario  String?
  numeroInterno    String?
  distintivo       String?
  cartelSuperior   String?
  capacidad        Int
  estado           String    @default("pendiente")
  // Login por vehículo (M3, doc técnico §15.3): credencial emitida por el sindicato, el
  // conductor se identifica al iniciar la sesión operativa. Nunca se hashea en la app;
  // backend usa el hasher scrypt auditado que exporta Better Auth.
  credencialHash   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  asignaciones       Asignacion[]
  desafiosAuthMovil  DesafioAuthMovil[]
  sesionesOperativas SesionOperativa[]
  historialEstados   HistorialEstadoVehiculo[]

  @@unique([sindicatoId, placa])
  @@index([sindicatoId])
  @@index([tipo])
  @@index([estado])
  @@map("vehiculos")
}

model HistorialEstadoVehiculo {
  id              String    @id @default(uuid())
  sindicatoId     String
  sindicato       Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  vehiculoId      String
  vehiculo        Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  estadoDesde     String?
  estadoHasta     String
  motivo          String?
  observacion     String?
  retornoEstimado DateTime?
  actorId         String
  origen          String    @default("web")
  createdAt       DateTime  @default(now())

  @@index([sindicatoId, createdAt])
  @@index([vehiculoId, createdAt])
  @@map("historial_estados_vehiculo")
}

model Conductor {
  id                 String    @id @default(uuid())
  sindicatoId        String
  sindicato          Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  nombre             String
  documentoIdentidad String
  licenciaConducir   String
  estado             String    @default("activo")
  // PIN personal del conductor para el segundo paso del acceso móvil. El valor plano
  // nunca se persiste: se usa el mismo hasher scrypt exportado por Better Auth.
  credencialHash     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asignaciones       Asignacion[]
  desafiosAuthMovil  DesafioAuthMovil[]
  sesionesOperativas SesionOperativa[]

  @@unique([sindicatoId, documentoIdentidad])
  @@index([sindicatoId])
  @@map("conductores")
}

// Catálogo nacional de ciudades/áreas de cobertura. Existe para que `Linea.cityId`
// (Control) pueda scopear cada línea a una ciudad — sin esta tabla, crear una línea
// revienta con 500 en `lineas.service.ts` (hace `tx.mobilityCity.findUnique(...)`). La línea
// sigue perteneciendo a un sindicato; la ciudad solo evita mezclar códigos iguales entre
// departamentos y permite activar nuevas fuentes de forma gradual.
model MobilityCity {
  id                  String   @id
  nombre              String
  departamentoCodigo  String?
  departamentoNombre  String?
  paisCodigo          String   @default("BO")
  zonaHoraria         String   @default("America/La_Paz")
  estadoCobertura     String   @default("coming_soon")
  fuenteTipo          String?
  fuenteNombre        String?
  fuenteLicencia      String?
  fuenteActualizadaAt DateTime?
  modosDisponibles    String[] @default([])
  serviciosAuxiliares String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  lineas Linea[]

  @@index([estadoCobertura])
  @@map("mobility_cities")
}

model Linea {
  id              String    @id @default(uuid())
  sindicatoId     String
  sindicato       Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  cityId          String    @default("cochabamba")
  mobilityCity    MobilityCity @relation(fields: [cityId], references: [id], onDelete: Restrict)
  codigo          String
  nombre          String
  color           String?
  colorSecundario String?
  colorTexto      String?
  colorTerciario  String?
  colorFondo      String?
  nombreCorto     String?
  lema            String?
  descripcion     String?
  logoUrl         String?
  distintivoTipo  String?
  distintivoValor String?
  cartelSuperior  String?
  cartelFormato   String?
  cartelTitulo    String?
  cartelDetalle   String?
  cartelNumeroPosicion String?
  cartelLogoPosicion   String?
  cartelColorTitulo    String?
  cartelColorDetalle   String?
  cartelColorNumero    String?
  cartelColorBorde     String?
  publicStatus         String    @default("borrador")
  publishedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rutas Ruta[]

  @@unique([sindicatoId, codigo])
  @@index([sindicatoId])
  @@index([cityId, publicStatus])
  @@index([publicStatus])
  @@index([publicStatus, codigo])
  @@index([publicStatus, nombre])
  @@map("lineas")
}

// `geometria`/`coord`: Prisma no tipa GEOGRAPHY nativo — `Unsupported(...)` deja el tipo SQL
// crudo tal cual en la migración (PostGIS ya está habilitado en la DB, ver docker-compose.yml).
// Sin CRUD todavía (llega con QUI-225/226) — este es solo el shape de la tabla.
model Ruta {
  id        String                                    @id @default(uuid())
  lineaId   String
  linea     Linea                                     @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  sentido   String
  geometria Unsupported("geography(LineString,4326)")
  estado    String                                    @default("activo")
  publicStatus String                                  @default("borrador")
  publishedAt DateTime?
  createdAt DateTime                                  @default(now())
  updatedAt DateTime                                  @updatedAt

  variantes     Variante[]
  paradas       Parada[]
  puntosControl PuntoControl[]
  asignaciones  Asignacion[]

  @@index([lineaId])
  @@index([publicStatus])
  @@index([publicStatus, estado, lineaId])
  @@map("rutas")
}

model Variante {
  id        String   @id @default(uuid())
  rutaId    String
  ruta      Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  nombre    String
  // Soft-delete (nunca DELETE real): mismo criterio que el resto del dominio.
  estado    String   @default("activo")
  publicStatus String @default("borrador")
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rutaId])
  @@index([publicStatus])
  @@index([publicStatus, estado, rutaId])
  @@map("variantes")
}

model Parada {
  id        String                               @id @default(uuid())
  rutaId    String
  ruta      Ruta                                 @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  tipo      String
  orden     Int
  nombre    String?
  referencia String?
  coord     Unsupported("geography(Point,4326)")
  // Soft-delete (nunca DELETE real): mismo criterio que el resto del dominio.
  estado    String                               @default("activo")
  publicStatus String                             @default("borrador")
  publishedAt DateTime?
  createdAt DateTime                             @default(now())
  updatedAt DateTime                             @updatedAt

  @@index([rutaId])
  @@index([publicStatus])
  @@index([publicStatus, estado, rutaId, orden])
  @@map("paradas")
}

model PuntoControl {
  id               String                               @id @default(uuid())
  rutaId           String
  ruta             Ruta                                 @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  orden            Int
  coord            Unsupported("geography(Point,4326)")
  radioToleranciaM Int
  obligatorio      Boolean                              @default(true)
  // Soft-delete (nunca DELETE real): `CumplimientoPc.puntoControlId` referencia este id sin
  // FK (mismo patrón polimórfico que Sancion.sujetoId/AuditLog.entidadId) — un DELETE real
  // dejaría ese historial apuntando a un id inexistente.
  estado           String                               @default("activo")
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt

  @@index([rutaId])
  @@map("puntos_control")
}

// `sindicatoId` nullable: acciones de `admin_quivo` (sin tenant propio) también se auditan.
model AuditLog {
  id          String     @id @default(uuid())
  sindicatoId String?
  sindicato   Sindicato? @relation(fields: [sindicatoId], references: [id], onDelete: SetNull)
  usuarioId   String
  entidad     String
  entidadId   String
  accion      String
  diff        Json?
  ts          DateTime   @default(now())

  @@index([sindicatoId, ts])
  @@map("audit_log")
}

// M2 — Rotaciones (RF-51..57, QUI-231). `estado`: borrador | publicada — solo las
// publicadas alimentan la app móvil (QUI-232). `periodo` es texto libre (ej. "2026-08"),
// el doc técnico no fija un formato exacto.
model Rotacion {
  id          String    @id @default(uuid())
  sindicatoId String
  sindicato   Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  periodo     String
  estado      String    @default("borrador")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asignaciones Asignacion[]

  @@index([sindicatoId])
  @@map("rotaciones")
}

// `@@unique([vehiculoId, fecha, horario])`: la barrera real contra doble-asignación
// (doc técnico §12, riesgo "conflicto operativo real en la calle") — un vehículo no puede
// tener dos asignaciones el mismo día en el mismo horario, sin importar qué rotación las
// contenga. `conductorId` nullable: la rotación puede publicarse con el vehículo asignado
// y el conductor por confirmar después. `horario` es texto libre (ver
// packages/shared/src/enums/estados.ts `TurnoSchema` para los 3 valores usados por la UI —
// asunción no confirmada por Producto, igual que las transiciones de estado de vehículos).
model Asignacion {
  id               String     @id @default(uuid())
  rotacionId       String
  rotacion         Rotacion   @relation(fields: [rotacionId], references: [id], onDelete: Cascade)
  vehiculoId       String
  vehiculo         Vehiculo   @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  conductorId      String?
  conductor        Conductor? @relation(fields: [conductorId], references: [id], onDelete: SetNull)
  rutaId           String
  ruta             Ruta       @relation(fields: [rutaId], references: [id], onDelete: Restrict)
  fecha            DateTime   @db.Date
  horario          String
  // Hora exacta de despacho y presentación (modelo operativo Línea 120, piloto Tiquipaya)
  // — opcionales: `horario` (mañana/tarde/noche) sigue siendo el único dato obligatorio y
  // el que rige el constraint de unicidad de abajo; estas dos solo se completan cuando la
  // generación recibe configuración de horario pico (headway) para ese `horario`. Filas
  // creadas antes de este cambio, o creadas a mano sin esa config, quedan en null.
  horaSalida       DateTime?
  horaPresentacion DateTime?
  orden            Int
  venceAt          DateTime
  // vigente | vencida (RF-57, QUI-234) — la marca un job BullMQ repeatable
  // (RotacionesModule) cuando `venceAt` ya pasó, no el request que la creó.
  estado           String     @default("vigente")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sesionesOperativas SesionOperativa[]

  @@unique([vehiculoId, fecha, horario])
  @@index([rotacionId])
  @@index([estado, venceAt])
  @@index([rutaId, estado, venceAt])
  @@map("asignaciones")
}

// M3 — autenticación móvil encadenada. El token del desafío y los tokens de sesión se
// entregan una sola vez al cliente; en Postgres sólo quedan hashes SHA-256 revocables.
model DesafioAuthMovil {
  id                String     @id @default(uuid())
  sindicatoId       String
  sindicato         Sindicato  @relation(fields: [sindicatoId], references: [id], onDelete: Cascade)
  vehiculoId        String
  vehiculo          Vehiculo   @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  conductorId       String?
  conductor         Conductor? @relation(fields: [conductorId], references: [id], onDelete: SetNull)
  tokenHash         String     @unique
  deviceId          String
  expiresAt         DateTime
  consumedAt        DateTime?
  intentosConductor Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([vehiculoId, expiresAt])
  @@index([sindicatoId])
  @@map("desafios_auth_movil")
}

model SesionOperativa {
  id               String     @id @default(uuid())
  sindicatoId      String
  sindicato        Sindicato  @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  asignacionId     String
  asignacion       Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Restrict)
  vehiculoId       String
  vehiculo         Vehiculo   @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  conductorId      String
  conductor        Conductor  @relation(fields: [conductorId], references: [id], onDelete: Restrict)
  deviceId         String
  inicio           DateTime   @default(now())
  fin              DateTime?
  estado           String     @default("activa")
  accessTokenHash  String     @unique
  refreshTokenHash String     @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  cumplimientosPc   CumplimientoPc[]
  eventosOperativos EventoOperativo[]

  @@index([sindicatoId])
  @@index([asignacionId, estado])
  @@index([deviceId, estado])
  @@index([vehiculoId, estado])
  @@index([vehiculoId, estado, fin, inicio(sort: Desc)])
  @@map("sesiones_operativas")
}

// M4 — Reglas y sanciones (RF-40..50, QUI-244). El doc técnico (§4.2) deja el modelo muy
// comprimido ("estatutos/reglas(id, sindicato_id, tipo, gravedad, aplica_a, relacion)") sin
// especificar campos como `nombre`/`descripcion` — se agregan acá por usabilidad admin
// (asunción de este equipo, no una decisión de Producto confirmada), igual que
// `gravedad` (`leve`/`grave`/`gravisima`, tampoco especificado).
model Regla {
  id          String    @id @default(uuid())
  sindicatoId String
  sindicato   Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  nombre      String
  tipo        String
  gravedad    String
  // A qué tipo de sujeto aplica esta regla — mismo dominio que `Sancion.sujetoTipo`.
  aplicaA     String
  descripcion String?
  estado      String    @default("activo")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sanciones Sancion[]

  @@index([sindicatoId])
  @@map("reglas")
}

// `sujetoId` sin FK (a propósito): puede apuntar a `vehiculos`, `conductores` o `socios`
// según `sujetoTipo` — mismo patrón polimórfico sin FK que `AuditLog.entidadId`.
// `evidenciaRef` queda como texto libre por ahora: "evidencia auto-vinculada" (doc técnico
// §15.5: sesión/cumplimientos_pc/desvíos) requiere que exista tracking real (M3), que esta
// sesión no llegó a construir — ver rotaciones.service.ts / módulos tracking/sync.
model Sancion {
  id           String    @id @default(uuid())
  sindicatoId  String
  sindicato    Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  reglaId      String
  regla        Regla     @relation(fields: [reglaId], references: [id], onDelete: Restrict)
  sujetoTipo   String
  sujetoId     String
  motivo       String
  fechaHecho   DateTime  @db.Date
  evidenciaRef String?
  estado       String    @default("pendiente")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sindicatoId])
  @@index([reglaId])
  @@index([sujetoTipo, sujetoId])
  @@map("sanciones")
}

// M3 — ingesta de tracking (RF-58..66, QUI-241). `gps_points` (el evento `gps_point` del
// outbox móvil, QUI-238) es una tabla particionada por rango de `ts` — `pg_partman` no está
// disponible en esta imagen de Postgres (`postgis/postgis:16-3.4-alpine`, verificado:
// `pg_available_extensions` no lo lista), así que se usa particionado nativo declarativo +
// una función/job de mantenimiento (ver migración y `worker.ts`) en vez de la extensión.
// Por eso `gps_points` NO tiene modelo Prisma acá — mismo criterio que las columnas
// GEOGRAPHY: lo que Prisma no puede representar bien (una tabla particionada) se maneja
// fuera del Client, solo SQL crudo (`worker.ts`).
//
// QUI-358 (cierra la decisión diferida de `20260802160000_ingesta_gps_worker`, "evaluar en
// M4 ... desnormalizar sindicatoId + RLS"): la tabla tiene `sindicatoId` propia y
// `FORCE ROW LEVEL SECURITY`, igual que las otras 15 tablas con RLS (ver
// `20260815120000_gps_points_sindicato_rls`). Al ser particionada, la policy del padre NO
// alcanza un acceso directo a una partición hija por nombre (`gps_points_20260915`, no vía
// `gps_points`) — verificado a mano, ver esa migración — así que la policy se repite
// también en cada partición, existente y futura (`crear_particion_gps_points` quedó
// redefinida para hacerlo sola en cada partición nueva).

/**
 * Cumplimiento de un punto de control durante un recorrido — evento `cumplimiento_punto_control`
 * del outbox móvil. `validadoPor` distingue la detección local del chofer (QUI-239,
 * `'app'`) de la validación server-side (fuente de verdad auditada, RF-39, `'worker'`);
 * una discrepancia entre ambas no se resuelve acá, queda como observación (RNF-37).
 */
model CumplimientoPc {
  id             String          @id @default(uuid())
  // `event_id` UUIDv7 del outbox móvil (QUI-238) — reenviar el mismo lote N veces (RF-72)
  // no debe duplicar el cumplimiento, mismo criterio de idempotencia que `gps_points`.
  eventId        String          @unique
  sindicatoId    String
  sindicato      Sindicato       @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  sesionId       String
  sesion         SesionOperativa @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  puntoControlId String
  ts             DateTime
  distanciaM     Float
  cumplido       Boolean
  validadoPor    String
  // Multi-vuelta (plan §2.3): número de pasada de este punto de control dentro de la
  // sesión, calculado en el móvil por la máquina de estados con histéresis
  // (`filtrarNuevosCumplimientos`, `apps/mobile/src/gps/geofence.ts`). NULLABLE a
  // propósito, NUNCA UNIQUE junto con (sesionId, puntoControlId): APKs anteriores a este
  // cambio no lo mandan (queda `null`, nunca se rechaza el evento), y si la semilla del
  // móvil falla y el contador reinicia en 1, un UNIQUE compuesto descartaría en silencio
  // una pasada real que sí ocurrió — un constraint que borra evidencia es peor que un
  // duplicado detectable. Ver `20260817140000_cumplimientos_pc_pasada`.
  pasada         Int?
  receivedAt     DateTime        @default(now())

  @@index([sindicatoId])
  @@index([sesionId])
  @@index([puntoControlId])
  // Multi-vuelta (plan §2.3): la consulta natural del mundo con N pasadas — "todos los
  // cumplimientos de esta sesión y este punto de control, ordenados en el tiempo" (p. ej.
  // `construirTimeline`/`recorridos/[id]`, "N pasadas · última a Xm") — no tenía ningún
  // índice compuesto que la sirviera; los tres de arriba son separados.
  @@index([sesionId, puntoControlId, ts])
  @@map("cumplimientos_pc")
}

/**
 * Eventos operativos genéricos del outbox móvil que no tienen tabla propia: `inicio_recorrido`,
 * `fin_recorrido`, `observacion` (RF-67, RF-70..73). El doc técnico no detalla un modelo
 * separado para "recorrido" en sí — se guardan como bitácora genérica (asunción de este
 * equipo) en vez de mutar `SesionOperativa.inicio/fin` (esos campos son del ciclo de vida de
 * la sesión operativa completa, QUI-235, no de cada recorrido individual dentro de ella).
 */
model EventoOperativo {
  id          String          @id @default(uuid())
  // Mismo motivo que en CumplimientoPc: idempotencia por event_id del outbox (RF-72).
  eventId     String          @unique
  sindicatoId String
  sindicato   Sindicato       @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  sesionId    String
  sesion      SesionOperativa @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  deviceId    String
  tipo        String
  ts          DateTime
  payload     Json
  receivedAt  DateTime        @default(now())

  @@index([sindicatoId])
  @@index([sesionId])
  @@map("eventos_operativos")
}

/**
 * Lotes/eventos rechazados por el worker de ingesta (RNF-35, QUI-241/242) — nada se
 * descarta en silencio, queda visible en el admin con motivo.
 */
model SyncError {
  id          String    @id @default(uuid())
  sindicatoId String
  sindicato   Sindicato @relation(fields: [sindicatoId], references: [id], onDelete: Restrict)
  deviceId    String
  // Best-effort: extraído de `payload.sesionId` cuando el evento lo trae (no todos los
  // fallos lo tienen — p. ej. un evento operativo sin `sesionId` en el payload, QUI-241,
  // falla precisamente por no tenerlo). Nullable a propósito.
  sesionId    String?
  eventId     String?
  payload     Json
  error       String
  ts          DateTime  @default(now())

  @@index([sindicatoId])
  @@index([deviceId])
  @@index([sesionId])
  @@map("sync_errors")
}

// M5 — manifiesto del archivo frío de particiones GPS (QUI-252). No tiene sindicatoId:
// cada partición diaria mezcla sesiones de varios tenants y solo la procesa el worker
// global. `gps_points` sigue deliberadamente fuera de Prisma por ser particionada.
model GpsArchive {
  id              String   @id @default(uuid())
  partitionName   String   @unique
  partitionDate   DateTime @db.Date
  bucket          String
  objectKey       String   @unique
  rowCount        BigInt
  compressedBytes BigInt
  sha256          String
  archivedAt      DateTime @default(now())

  @@index([partitionDate])
  @@map("gps_archives")
}

// Solicitudes públicas de demostración enviadas desde la landing. No pertenecen a
// ningún sindicato todavía: el equipo las revisa antes de convertirlas en un piloto.
model DemoRequest {
  id           String   @id @default(uuid())
  name         String
  line         String
  city         String
  lineCount    Int
  vehicleCount Int?
  source       String   @default("landing")
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("demo_requests")
}
