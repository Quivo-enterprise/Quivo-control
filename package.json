{
  "name": "quivo-control",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:acceptance:prepare": "set -a && . apps/api/.env && set +a && pnpm --filter @quivo/db prisma:migrate:deploy && pnpm --filter @quivo/db prisma:seed",
    "test:acceptance": "playwright test",
    "piloto:extender-asignaciones": "packages/db/node_modules/.bin/tsx scripts/extender-asignaciones-piloto.ts",
    "test:scripts": "vitest run scripts/lib",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "@quivo/db": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "turbo": "^2.10.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
